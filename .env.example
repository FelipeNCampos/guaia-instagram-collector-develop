# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=instagram
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=instagram_db
DB_PORT_EXTERNAL=5432

# ── Coleta ────────────────────────────────────────────────────────────────────
# Termo de busca usado quando o coletor é executado direto pela CLI (sem GuaIA).
SEARCH_TERM=
# Quantidade alvo de posts (a paginação do Google é interrompida ao atingir).
TARGET_POSTS=200

# ── GuaIA ─────────────────────────────────────────────────────────────────────
# ID que o GuaIA usa como query_source para a rede social Instagram.
# Você precisa preencher esse valor; sem ele o feeder não processa consultas.
INSTAGRAM_QUERY_SOURCE=

# ── Comportamento ─────────────────────────────────────────────────────────────
# true  = Chrome sem janela (obrigatório no Docker / servidor)
# false = janela visível (necessário para login manual no Instagram)
HEADLESS=true

# Workers paralelos para enriquecer posts/reels (abre N abas ao mesmo tempo).
INSTAGRAM_POST_WORKERS=4

# Quantos posts enriquecer entre cada checkpoint de progresso.
INSTAGRAM_POST_CHECKPOINT_INTERVAL=10

# Bloquear imagens no Chrome para acelerar a coleta (1 = sim, 0 = não).
INSTAGRAM_BLOCK_IMAGES=1

# Comentarios e midias sao best-effort: falhas nao derrubam a coleta principal.
INSTAGRAM_FETCH_COMMENTS=false
INSTAGRAM_COMMENTS_PER_POST=50
INSTAGRAM_COMMENTS_CONCURRENCY=3
INSTAGRAM_DOWNLOAD_MEDIA=false
INSTAGRAM_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60
INSTAGRAM_MEDIA_MAX_BYTES=262144000
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ── 2Captcha (reCAPTCHA / hCaptcha no Google e no Instagram) ───────────────────
# Chave da conta: https://2captcha.com/enterpage — defina em .env (não versionar).
# Com a chave definida, o coletor NÃO usa mais cookies Netscape do Google por padrão.
#
# Docker: scripts/dev.sh usa --env-file .env.dev, mas o compose monta ./.env em /app/.env.
# Coloque TWOCAPTCHA_API_KEY no .env.dev (para o Compose repassar ao container) OU no .env
# montado; o docker-compose repassa explicitamente TWOCAPTCHA_* ao serviço feeder.
TWOCAPTCHA_API_KEY=
# Opcional: forçar uso do arquivo cookies.txt mesmo com 2Captcha (1 = sim).
INSTAGRAM_USE_GOOGLE_COOKIES_FILE=0
# Timeout (s) só para reCAPTCHA no worker 2Captcha (padrão interno costuma ser 600).
TWOCAPTCHA_RECAPTCHA_TIMEOUT=600
